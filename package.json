{
  "name": "playrusty",
  "version": "0.1.0",
  "private": true,
  "description": "Learn Rust by playing: a browser adventure based on rustlings.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p . && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -p .",
    "verify:rust": "tsx scripts/verify-rust.ts"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/view": "^6.43.15",
    "codemirror": "^6.0.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  }
}
